APP_NAME=ABOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dhaka

# বাংলাই ডিফল্ট — ডিপোর পর্দা বাংলায় খোলে, ইংরেজি দ্বিতীয় পছন্দ
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, sqlite নয় — আর এটা পছন্দের প্রশ্ন নয়।
#
# নম্বর সিরিজের ইঞ্জিন `SELECT ... FOR UPDATE` দিয়ে ঠেকায় যাতে দুইজন
# একই বিলের নম্বর না পান, আর sqlite-এ row lock বলে কিছুই নেই। DECIMAL(18,4)
# ওখানে float হয়ে যায়, তাই "টাকা কখনো float নয়" পাহারাটাও কিছুই মাপে না।
# phpunit.xml ও CI দুই জায়গাতেই একই কারণ লেখা আছে।
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# HTTPS-এ চললে অবশ্যই true — নাহলে সেশন কুকিটা সাধারণ HTTP-তেও যায়,
# আর একই নেটওয়ার্কের কেউ ওটা পড়ে লগইন করা অবস্থায় ঢুকে পড়তে পারে।
# উন্নয়নে (http://abos.test) false-ই থাকুক, নাহলে লগইনই হবে না।
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── ABOS-এর নিজের ঘরগুলো ────────────────────────────────────────────

# ব্যাকআপ কোথায় জমবে। storage/-এর ভেতরে নয় — storage নিজেও ব্যাকআপের
# অংশ, আর ব্যাকআপ নিজের ভেতরে নিজেকে রাখতে পারে না।
# ABOS_BACKUP_PATH=

# দ্বিতীয় গন্তব্য — অন্য ডিস্ক, নেটওয়ার্ক ড্রাইভ বা পেনড্রাইভ।
# একই ডিস্কে রাখা ব্যাকআপ ডিস্ক ফেল করলে ব্যাকআপও নিয়ে যায়।
# ABOS_BACKUP_MIRROR=

ABOS_BACKUP_KEEP_DAYS=30
ABOS_BACKUP_AT=01:30

# mysqldump ও mysql কোথায়। Laragon-এ এগুলো PATH-এ থাকে না, আর না পেলে
# ব্যাকআপ নীরবে ব্যর্থ হয় — অর্থাৎ ছয় মাস পর জানা যাবে যে একটাও নেই।
# ABOS_MYSQLDUMP="C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysqldump.exe"
# ABOS_MYSQL="C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysql.exe"

# Content-Security-Policy হেডার। কোনো পর্দা ভাঙলে `off` দিয়ে সাথে সাথে
# থামানো যায় — নিরাপত্তার হেডারের জন্য কাউন্টার বন্ধ থাকা সবচেয়ে খারাপ ফল।
# ABOS_CSP=on
