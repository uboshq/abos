# ── ABOS — লাইভ সার্ভারের নমুনা .env ──────────────────────────────────
#
# এই ফাইল কপি করে `.env` বানান, তারপর খালি ঘরগুলো ভরুন। প্রতিটা মান
# লাইভের জন্য নিরাপদ দিকে বসানো; উন্নয়নের নমুনা `.env.example`।
# ⛔ এখানে কোনো গোপন মান নেই, আর থাকবেও না — পাসওয়ার্ড, চাবি সব খালি।
# ⚠️ মান বদলানোর পর `php artisan abos:optimise` — কনফিগ ক্যাশ পুরনো
# মান ধরে রাখে, আর `.env` বদলটা তখন নীরবে পৌঁছায় না।

APP_NAME=ABOS
APP_ENV=production
# ⛔ `php artisan key:generate` দিয়ে প্রতিটা সার্ভারে আলাদা; হারালে সব এনক্রিপ্ট করা মান অপাঠ্য
APP_KEY=
# ⛔ true হলে ভুলের পাতায় পুরো স্ট্যাক, কোয়েরি আর .env-এর মান বাইরের যে কারো সামনে
APP_DEBUG=false
# https দিয়ে — চিঠির লিংক, পাসওয়ার্ড রিসেট আর শেয়ার করা কাগজের ঠিকানা এখান থেকেই বানানো হয়
APP_URL=https://erp.example.com
APP_TIMEZONE=Asia/Dhaka

# বাংলাই ডিফল্ট — ডিপোর পর্দা বাংলায় খোলে, ইংরেজি দ্বিতীয় পছন্দ
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# চাবি ঘোরানোর সময় পুরনো APP_KEY গুলো কমা দিয়ে — নাহলে পুরনো কুকি ও এনক্রিপ্ট করা ঘর অপাঠ্য
# APP_PREVIOUS_KEYS=

BCRYPT_ROUNDS=12

# daily: প্রতিদিন আলাদা ফাইল, LOG_DAILY_DAYS দিন পরে নিজে মোছে — একটা ফাইল ডিস্ক ভরায় না
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
# warning: ব্যাকআপ ব্যর্থতা (critical) আর স্বাস্থ্য-পরীক্ষার কারণ (warning) থাকে; debug লাইভে ডিস্ক ভরায় আর গ্রাহকের তথ্য লগে তোলে
LOG_LEVEL=warning

# MySQL/MariaDB, sqlite নয় — নম্বর সিরিজ `SELECT ... FOR UPDATE`-এ দাঁড়িয়ে, আর টাকা DECIMAL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abos
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# সেশন ফাইল ডিস্কে থাকে — এনক্রিপ্ট করলে সার্ভারের ফাইল পড়তে পারা কেউ সেশন পড়তে পারে না (চালু করার দিন সবাই একবার লগআউট হন)
SESSION_ENCRYPT=true
# ⛔ লাইভ HTTPS-এ, তাই true — নাহলে সেশন কুকি খোলা http-তেও যায়
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
# lax, strict নয়: WhatsApp বা মেইলের লিংক থেকে ERP-র পাতায় এলে strict কুকি পাঠায় না, আর মানুষ লগইন থাকা অবস্থায়ও লগইন পর্দা দেখতেন; CSRF টোকেন আলাদাই পাহারা দেয়
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ⛔ log নয় — লাইভে পাসওয়ার্ড রিসেটের চিঠি সত্যিই যেতে হবে। ঠিকানাটা প্রেরকের ডোমেইনের সত্যিকারের মেইলবক্স, নাহলে SPF/DKIM মেলে না
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@erp.example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── ABOS-এর নিজের ঘরগুলো ────────────────────────────────────────────

# ব্যাকআপ কোথায় জমবে। storage/-এর ভেতরে নয় — storage নিজেও ব্যাকআপের অংশ
# ABOS_BACKUP_PATH=
# দ্বিতীয় গন্তব্য — অন্য ডিস্ক বা নেটওয়ার্ক ড্রাইভ; একই ডিস্কের ব্যাকআপ ডিস্কের সাথেই মরে
# ABOS_BACKUP_MIRROR=
ABOS_BACKUP_KEEP_DAYS=30
ABOS_BACKUP_AT=01:30
# mysqldump ও mysql PATH-এ না থাকলে পুরো পথ — না পেলে ব্যাকআপ ব্যর্থ হয়, আর সেটা জানা যায় দেরিতে
# ABOS_MYSQLDUMP=
# ABOS_MYSQL=
# শেল থাকলেও বিশুদ্ধ PHP-র ডাম্পার — কেবল mysqldump-এর সংস্করণ না মিললে
ABOS_BACKUP_FORCE_PHP=false

# CSP হেডার। কোনো পর্দা ভাঙলে off দিয়ে তখনই থামানো যায় (তারপর abos:optimise)
ABOS_CSP=on
# /health এর নিচে খালি জায়গা নামলে ৫০৩ — ডিস্ক ভরার আগেই জানা, কারণ ভরলে প্রথমে নীরবে ব্যাকআপ থামে
ABOS_HEALTH_MIN_FREE_MB=1024
# ইমেইল বদলের নিশ্চিতকরণ লিংক কত মিনিট বাঁচে — পাসওয়ার্ড রিসেটের সমান
ABOS_EMAIL_CHANGE_EXPIRE=60

# লাইসেন্স যাচাইয়ের পাবলিক চাবি (গোপন চাবি কোনোদিন সার্ভারে নয়)
ABOS_LICENCE_PUBLIC_KEY=
# ⛔ true কেবল চাবি বসানো আর কাগজ ইস্যুর পরে — আগে দিলে সার্ভারটাই তালাবদ্ধ
ABOS_LICENCE_ENFORCED=false

# ফোনের অ্যাপের সংস্করণ (GET /api/v1/app/version)। ফাঁকা থাকলে দরজা 503 দেয় আর ফোন কিছুই করে না; রিলিজের সময় বসান।
ANDROID_VERSION_CODE=
ANDROID_VERSION_NAME=
ANDROID_APK_URL=
# ফোন নিজে APK বসায়, তাই ফাইলের sha256 (৬৪ অক্ষর, ছোট হাতের) আর বাইটে আকার বাধ্যতামূলক; লিংক কেবল https।
ANDROID_APK_SHA256=
ANDROID_APK_SIZE_BYTES=
ANDROID_MINIMUM_CODE=
ANDROID_NOTE_BN=
ANDROID_NOTE_EN=

# ── Laravel-এর নিজের সূক্ষ্ম সুর ─────────────────────────────────────
#
# কোড এগুলো পড়ে, কিন্তু ডিফল্টেই ঠিক চলে — তাই মন্তব্যে রাখা। ⚠️ খালি
# রেখে মন্তব্য তুলবেন না: `KEY=` দিলে env() ফেরত দেয় '', ডিফল্ট নয়।
# পাহারা: [[TheCspSwitchVanishedUnderConfigCacheTest]] — কোডের প্রতিটা
# env() চাবি এই ফাইলে থাকতেই হবে।
# AUTH_GUARD=
# AUTH_MODEL=
# AUTH_PASSWORD_BROKER=
# AUTH_PASSWORD_RESET_TOKEN_TABLE=
# AUTH_PASSWORD_TIMEOUT=

# AWS_ENDPOINT=
# AWS_URL=

# BEANSTALKD_QUEUE=
# BEANSTALKD_QUEUE_HOST=
# BEANSTALKD_QUEUE_RETRY_AFTER=

# CACHE_STORAGE_DISK=
# CACHE_STORAGE_PATH=

# DB_CACHE_CONNECTION=
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=
# DB_CACHE_TABLE=
# DB_CHARSET=
# DB_COLLATION=
# DB_ENCRYPT=
# DB_FOREIGN_KEYS=
# DB_QUEUE=
# DB_QUEUE_CONNECTION=
# DB_QUEUE_RETRY_AFTER=
# DB_QUEUE_TABLE=
# DB_SOCKET=
# DB_SSLMODE=
# DB_TRUST_SERVER_CERTIFICATE=
# DB_URL=

# DYNAMODB_CACHE_TABLE=
# DYNAMODB_ENDPOINT=

# LOG_DEPRECATIONS_TRACE=
# LOG_PAPERTRAIL_HANDLER=
# LOG_SLACK_EMOJI=
# LOG_SLACK_USERNAME=
# LOG_SLACK_WEBHOOK_URL=
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=

# MAIL_EHLO_DOMAIN=
# MAIL_LOG_CHANNEL=
# MAIL_SENDMAIL_PATH=
# MAIL_URL=

# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=
# MEMCACHED_PORT=
# MEMCACHED_USERNAME=

# MYSQL_ATTR_SSL_CA=

# PAPERTRAIL_PORT=
# PAPERTRAIL_URL=

# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=

# QUEUE_FAILED_DRIVER=

# REDIS_BACKOFF_ALGORITHM=
# REDIS_BACKOFF_BASE=
# REDIS_BACKOFF_CAP=
# REDIS_CACHE_CONNECTION=
# REDIS_CACHE_DB=
# REDIS_CACHE_LOCK_CONNECTION=
# REDIS_CLUSTER=
# REDIS_DB=
# REDIS_MAX_RETRIES=
# REDIS_PERSISTENT=
# REDIS_PREFIX=
# REDIS_QUEUE=
# REDIS_QUEUE_CONNECTION=
# REDIS_QUEUE_RETRY_AFTER=
# REDIS_URL=
# REDIS_USERNAME=

# RESEND_API_KEY=

# SANCTUM_STATEFUL_DOMAINS=
# SANCTUM_TOKEN_PREFIX=

# SESSION_CONNECTION=
# SESSION_COOKIE=
# SESSION_EXPIRE_ON_CLOSE=
# SESSION_PARTITIONED_COOKIE=
# SESSION_STORE=
# SESSION_TABLE=

# SLACK_BOT_USER_DEFAULT_CHANNEL=
# SLACK_BOT_USER_OAUTH_TOKEN=

# SQS_PREFIX=
# SQS_QUEUE=
# SQS_SUFFIX=
