<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <!--
            ⭐ ডিপ্লয়ের আগে অন্তত এইগুলো — ২১ সেপ্টেম্বর ২০২৬।

            ⛔ কেন একটা আলাদা নাম দরকার হলো: শেয়ার করা গাছে পুরো সুট
            চালানো যায় না। ছয় ঘণ্টার রানের মাঝপথে একজন সহকর্মী ফাইল
            সেভ করলেই রানটা অচল হয় (d1-এর একটা এভাবেই বাতিল হয়েছে),
            তাই যিনি ডিপ্লয় করেন তিনি **যে পথে হাত পড়েছে** কেবল তার
            টেস্ট চালান।

            ⚠️ ফল: নিজের পথের বাইরের লাল কেউ দেখে না। ঠিক ঐ ফাঁকে
            টাকার উপর একটা `(float)` main-এ ঢুকে বসে ছিল, আর পাহারাটা
            লাল হয়েও কারও চোখে পড়েনি।

            ⓘ এই তালিকাটা "জরুরি টেস্ট" নয়। এগুলো সেইগুলো যাদের লাল
            হওয়ার মানে **খাতা ভুল, নয়তো একটা দরজা খোলা** — বদলটা
            যা নিয়েই হোক।

            চালাতে: php artisan test, আর testsuite ঘরটা money
        -->

        <!--
            ⭐ প্রতিটা কমিটে — ২২ সেপ্টেম্বর ২০২৬।

            ⓘ নিচের `money` সুটটা ২৪ মিনিট নেয়, তাই সেটা দিনে দুইবার
            চলে। ⚠️ যে নিয়ম ঐ গেটে ধরা পড়ে, সেটা ভাঙা অবস্থায়
            ঘণ্টার পর ঘণ্টা থাকতে পারে।

            ⛔ আজ ঠিক সেটাই হয়েছে: ভাড়ার পাতায় একটা রুট অনুমতি ছাড়া
            বসে গিয়েছিল, আর লগইন করা যে কেউ খাতায় নতুন পক্ষ বসাতে
            পারতেন — কয়েক ঘণ্টা লাইভে। ⓘ ধরেছে
            [[EveryRouteIsGuardedTest]], আর সে **দুই সেকেন্ডে** চলে।

            ⭐ এই পাঁচটার একটাও ডেটাবেস ছোঁয় না — মেপে ১৮ সেকেন্ডে
            ৩০টা দাবি। ⚠️ তাই এটা `money`-র বদলি নয়, তার আগের ধাপ:
            এরা খাতা দেখতে পায় না, ওরা পায়।

            চালাতে: php artisan test, আর testsuite ঘরটা money-fast
        -->
        <testsuite name="money-fast">
            <!-- কোনো দরজা পাহারা ছাড়া নয় — ২২ সেপ্টেম্বর একটা খোলা দরজা এটাই ধরেছে -->
            <file>tests/Feature/Architecture/EveryRouteIsGuardedTest.php</file>
            <!-- কমিট না করা ক্লাস ডাকা হচ্ছে না — লাইভে সাদা পর্দা -->
            <file>tests/Feature/Architecture/EveryClassTheCodeCallsIsActuallyCommittedTest.php</file>
            <!-- লেখা প্রতিটা নিয়ম সত্যিই কোনো পথে পৌঁছায় -->
            <file>tests/Feature/Architecture/EveryPolicyRuleIsActuallyReachedTest.php</file>
            <!-- নতুন কোনো দাবি অজুহাত দিয়ে এড়িয়ে যাচ্ছে না -->
            <file>tests/Feature/Architecture/ASkippedTestReadsAsAPassingOneTest.php</file>
            <!-- টাকার অঙ্ক — গোনা, গোল করা, লেখা -->
            <file>tests/Feature/Core/MoneyTest.php</file>
        </testsuite>

        <testsuite name="money">
            <!-- খাতার সিল — বদলানো, মোছা, আর সিল ছাড়া সারি ঢোকানো -->
            <file>tests/Feature/Core/TheBooksCouldBeEditedAndNobodyWouldKnowTest.php</file>
            <!-- আমাদের নিজের মাইগ্রেশন যেন সিলটা না ভাঙে -->
            <file>tests/Feature/Core/OurOwnMigrationBrokeTheSealTest.php</file>
            <!-- দুই-তরফা মেলানো, আর একই কাগজ দুইবার খাতায় না ওঠা -->
            <file>tests/Feature/Core/PostingEngineTest.php</file>
            <!-- টাকার অঙ্ক — গোনা, গোল করা, লেখা -->
            <file>tests/Feature/Core/MoneyTest.php</file>
            <!-- কোথাও টাকা float হয়ে না যাওয়া -->
            <file>tests/Feature/Architecture/MoneyIsNeverAFloatTest.php</file>
            <!-- বছর বন্ধ — মুনাফা সঞ্চিত মুনাফায় বসে -->
            <file>tests/Feature/Modules/YearEndTest.php</file>
            <!-- মালিকের চাবি — কে কার খাতা বদলাতে পারে -->
            <file>tests/Feature/Modules/SystemAdmin/TheUserAdminCouldTakeTheOwnersKeyTest.php</file>
            <!-- লেখা প্রতিটা নিয়ম সত্যিই কোনো পথে পৌঁছায় -->
            <file>tests/Feature/Architecture/EveryPolicyRuleIsActuallyReachedTest.php</file>
            <!-- কোনো দরজা পাহারা ছাড়া নয় -->
            <file>tests/Feature/Architecture/EveryRouteIsGuardedTest.php</file>
            <!-- কমিট না করা ক্লাস ডাকা হচ্ছে না — লাইভে সাদা পর্দা -->
            <file>tests/Feature/Architecture/EveryClassTheCodeCallsIsActuallyCommittedTest.php</file>
            <!-- নতুন কোনো দাবি অজুহাত দিয়ে এড়িয়ে যাচ্ছে না -->
            <file>tests/Feature/Architecture/ASkippedTestReadsAsAPassingOneTest.php</file>
            <!-- মেনুর প্রতিটা পাতা সত্যিই খোলে -->
            <file>tests/Feature/Architecture/EveryMenuPageOpensBeforeItIsDeployedTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run on MySQL, not sqlite in memory.

            The number series engine leans on SELECT ... FOR UPDATE to stop two
            people taking the same invoice number, and sqlite does not have row
            locks at all — the test would pass there and the bug would ship.
            Same reasoning for DECIMAL(18,4): sqlite stores it as a float.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="abos_test"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
