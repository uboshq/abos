# স্ট্যাটিক বিশ্লেষণের গেট — পরিকল্পনা ধাপ ১.১।
#
# টাইপ এই রিপোতে শুরু থেকেই লেখা — প্রতিটা মেথডে প্যারামিটার ও রিটার্ন
# টাইপ, PHPDoc-এ জেনেরিক পর্যন্ত। কিন্তু কেউ ওগুলো যাচাই করত না, আর যে
# টাইপ কেউ পড়ে না সেটা টাইপ নয় — মন্তব্য। PHP নিজে ধরে কেবল রানটাইমে,
# আর রানটাইম মানে কারো স্ক্রিন, কোনো একটা সোমবার সকালে।
#
# ── কেন খালি phpstan নয়, larastan ─────────────────────────────────────
# Eloquent-এর অর্ধেক API জাদু: `Model::where()` সত্যিকারের স্ট্যাটিক
# মেথড নয়, আর `$invoice->lines` প্রেক্ষাপট অনুযায়ী কখনো Relation কখনো
# Collection। খালি phpstan ওগুলো বোঝে না, তাই সে আসল বাগের বদলে শত শত
# মিথ্যা অভিযোগ দিত — আর যে যন্ত্র মিথ্যা বলে, দুই সপ্তাহে তার কথা কেউ
# আর পড়ে না। অকেজো গেট থাকার চেয়ে না থাকা সৎ, তাই এক্সটেনশনটা বাধ্যতামূলক।

includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # level 5 — শুরুর ধাপ, গন্তব্য নয়।
    #
    # ০ থেকে ৯ পর্যন্ত ধাপ আছে; ৫-এ এসে আর্গুমেন্টের টাইপ মেলানো শুরু হয়,
    # অর্থাৎ "এই মেথড string চায়, তুমি ?string দিচ্ছ" — এই শ্রেণীর ভুল।
    # টাকার অঙ্ক ও সংখ্যা-সিরিজের কোডে ঠিক ঐ শ্রেণীর ভুলই সবচেয়ে দামি।
    #
    # ৯-এ এক লাফে গেলে baseline এত বড় হত যে সেটা আর ঋণের হিসাব থাকত না,
    # হত আবর্জনার স্তূপ। ধাপে ধাপে বাড়ানোই শোধ করার একমাত্র উপায়।
    level: 5

    paths:
        - app
        # tests-ও কেন: একটা পরীক্ষা ভুল টাইপ নিয়ে লেখা হলে সে পাশ করে —
        # আর পাশ করা মিথ্যা পরীক্ষা না-থাকা পরীক্ষার চেয়ে খারাপ, কারণ
        # সেটা নিরাপত্তার ভুল অনুভূতি দেয়। EveryRouteIsGuardedTest-এর
        # মতো আর্কিটেকচার-পাহারাগুলো এখানে থাকায় ওগুলো নিজেরাও পাহারায়।
        - tests

    # ── larastan-কে আসল স্কিমাটা দেখতে দেওয়া ───────────────────────────
    # এই লাইনটা ছাড়া প্রথম রানে ৩,২৪২টা ত্রুটি এসেছিল, যার বিপুল
    # সংখ্যাগরিষ্ঠই "Access to an undefined property Account::$code" ধরনের
    # — অথচ কলামটা ডাটাবেজে দিব্যি আছে।
    #
    # কারণ: ১০৬টা মডেলের একটাতেও `@property` docblock নেই, আর Eloquent
    # কলামগুলো রানটাইমে ম্যাজিকে বসায়। ফলে বিশ্লেষক কলাম আর ছাপার ভুলের
    # মধ্যে পার্থক্য করতে পারত না।
    #
    # ঐ তিন হাজার সংকেত baseline-এ চাপা দিলে কাজ "শেষ" দেখাত, কিন্তু
    # তখন `$invoice->totl` লিখলেও গেট চুপ থাকত — অর্থাৎ যন্ত্রটা বসানোর
    # মূল উপকারটাই বাদ যেত। মাইগ্রেশন পড়লে সে সত্যিকারের কলাম চেনে,
    # আর তখন ছাপার ভুল আবার ত্রুটি হয়ে ওঠে।
    #
    # ── আর কেন দুইটা পথ, একটা নয় ──────────────────────────────────────
    # প্রথমবার কেবল `database/migrations` দিয়ে চালিয়ে সংখ্যাটা এক চুলও
    # নড়েনি — ৩,২৪২-ই রইল। কারণ এই রিপোর টেবিলগুলোর বড় অংশ ওখানে তৈরিই
    # হয় না: `accounts` টেবিলটা খুঁজলে ঐ ফোল্ডারে পাওয়া যায় না, অথচ
    # অন্য মাইগ্রেশন দিব্যি তার উপর foreign key বসাচ্ছে।
    #
    # আসল জায়গা `app/Modules/*/Database/Migrations` — ModuleServiceProvider
    # ওগুলো `loadMigrationsFrom()` দিয়ে তোলে (ঐ ফাইলের registerMigrations())।
    # মডিউলের স্কিমা মডিউলের ভিতরেই থাকে, আর সেটাই এই রিপোর গঠন।
    #
    # তারকাচিহ্নটা ইচ্ছাকৃত: larastan পথগুলো `glob()` দিয়ে খোলে, তাই
    # আগামীকাল নতুন কোনো মডিউল যোগ হলে এখানে কিছু লিখতে হবে না। হাতে
    # লেখা তালিকা হলে কেউ একদিন ভুলত, আর তখন ঐ মডিউলের প্রতিটা কলাম
    # নিঃশব্দে "undefined property" হয়ে ফিরত।
    databaseMigrationsPath:
        - database/migrations
        - app/Modules/*/Database/Migrations

    # ── কোন PHP সংস্করণ ধরে বিশ্লেষণ ───────────────────────────────────
    # composer.json বলে `"php": "^8.3"`, CI চালায় ৮.৩, আর এই লেখার দিনে
    # ডেভেলপারের মেশিনে চলছে ৮.৫.১০। ফাঁকটা আসল: ৮.৫-এ লেখা কোনো সিনট্যাক্স
    # ডেভেলপারের মেশিনে নিখুঁত চলবে, আর CI-তে parse error দিয়ে পড়বে।
    # পুরো সমর্থিত পরিসরটা ধরে বিশ্লেষণ করলে যন্ত্রটাই আগে বলে দেয়।
    phpVersion:
        min: 80300
        max: 80500
