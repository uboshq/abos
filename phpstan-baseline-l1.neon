# level 1-এর ছাড় — phpstan.l1.neon-এর নিজের (ec, ২২ অক্টোবর ২০২৬)। প্রতিটার উপরে এক লাইনের কারণ।
# ⛔ নতুন সারি হাতে নয়: আসল ভুল আগে সারান; বিশ্লেষকের ভুল হলে --generate-baseline, তারপর কারণ লিখুন।
# ⓘ reportUnmatchedIgnoredErrors চালু — কোনো ছাড় আর না লাগলে phpstan নিজেই বলে, তখন সারিটা তুলুন।
parameters:
	ignoreErrors:
		# সারির গড়নের docblock-এ route/vouched/address নেই — চলার সময় আছে, দেখানোর আগে তোলা হয়
		-
			message: '#^Cannot unset offset ''address'' on array\{label\: string, url\: string\|null, note\: string\|null, done\: bool\}\.$#'
			identifier: unset.offset
			count: 1
			path: app/Core/Engines/Map/MapEngine.php

		# অকারণ ?? — ক্ষতিহীন; খাতার ইঞ্জিন বিশ্লেষকের খাতিরে বদলানো হয় না
		-
			message: '#^Variable \$rowBranch on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: app/Core/Engines/Posting/PostingEngine.php

		# trait বা বিমূর্ত শ্রেণিতে new static — প্রতিটা উপশ্রেণি Eloquent/ফিল্টারের একই constructor নেয়, তাই নিরাপদ
		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: app/Modules/Accounts/Models/CostCenter.php

