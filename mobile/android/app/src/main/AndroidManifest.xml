<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Bluetooth, for the shop's thermal receipt printer.

      Those printers speak ESC/POS over a serial link and have no Android
      print service, so the system print dialog cannot see them at all — see
      core/printing/document_delivery.dart for why there are two roads to
      paper and why both print the same server-rendered PDF.

      Two sets, because Android 12 (API 31) split them. Before 31 a single
      BLUETOOTH permission was granted at install; from 31 CONNECT and SCAN
      are runtime permissions the person must allow. Declaring only the new
      pair would leave older handsets unable to print, and only the old one
      would fail silently on every recent phone, which reads in a shop as
      "the printer is broken".

      (A double hyphen is illegal inside an XML comment, and this file is the
      one place in the repository where that bites: it parses nowhere else,
      so the failure is a manifest merge error naming only the file.)

      neverForLocation on SCAN: this app looks for a paired printer, never
      for where anybody is. Without it Android treats a Bluetooth scan as a
      location request and asks the person for location permission, which is
      a frightening thing to be asked by a billing app and is not something
      it needs.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- A phone with no Bluetooth radio can still do everything else this app
         does, so the feature is wanted, not required: marking it required
         would hide the app in Play for those handsets. -->
    <uses-feature android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- চালান/গেট পাসের QR পড়ার ক্যামেরা (0.4.3) — কেবল "কাগজ স্ক্যান" পর্দা খুললে চায়।
         ক্যামেরা ছাড়া ফোনেও বাকি সব চলে, তাই required নয়। -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- কোপাইলটের মাইক (১২ নভেম্বর ২০২৬) — কেবল মাইক চাপলে চাওয়া; ফোন নিজে শুনে লেখা দেয়, অডিও কোথাও জমা হয় না
         (voice/VoiceChannel.kt)। মাইক ছাড়া ফোনেও কোপাইলট লেখায় চলে, তাই required নয়। -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature android:name="android.hardware.camera"
        android:required="false" />

    <!--
      Installing the app's own update (docs/Contract section 6, rule kha).

      The app downloads the APK, checks its size and its SHA-256 against what
      the server said, and only then hands it to the system package installer.
      Without this permission the installer refuses with "For your security,
      your phone is set to block..." even though the person is looking
      straight at the install prompt they meant to open.

      From Android 8 this buys only the right to ASK. The person still has to
      switch "install unknown apps" on for this app once, and Android still
      shows its own confirmation before every install. Neither is this app's
      to remove, and nothing here installs silently.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ⭐ App lock: fingerprint or the phone's own PIN (local_auth), 7 Oct 2026 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!--
      ⭐ Office SMS phone (owner's ok, sample U1X687u5MkwVfEL7ci7MGv step 2, 11 Nov 2026).
      SEND_SMS is asked for at run time, and only when someone switches the SMS gateway on
      (Profile → SMS gateway, shown only to a person holding notification.sms_gateway); on every
      other phone it stays unasked. The foreground service keeps sending while the app is closed;
      BOOT_COMPLETED brings it back after a power cut, and only if it was on.
      test/android_permissions_test.dart holds this list.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
      Storage and media reading, put in by open_filex (20 Oct 2026, release audit).

      This app opens only files it wrote itself, inside its own cache folder:
      the downloaded update (core/update/apk_installer.dart) and a paper the
      web window saved (features/web_inside). open_filex asks for these only
      for a path OUTSIDE the app's own folders (pathRequiresPermission), so
      none of the four is ever used, and each one would show on the install
      screen as "read your photos, videos and music". Photos are chosen
      through the system photo picker (image_picker), which needs none.
      test/android_permissions_test.dart holds this list.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <!-- ⛔ ব্যাকআপ বন্ধ — তালাবদ্ধ বাক্সের চাবি keystore-এ, ব্যাকআপে যায় না (পূর্ণ নিরীক্ষা §৯ ⚠️১১) -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="ABOS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              ⭐ নোটিশ বা SMS-এর erp.adi.com.bd লিংক এই অ্যাপে খোলে (Android App Links; সার্ভারের
              /.well-known/assetlinks.json এই অ্যাপের সই-চাবি মেলালে autoVerify পাস করে)। উপসর্গগুলো হুবহু
              lib/core/router/deep_links.dart-এর DeepLinks.prefixes (টেস্ট মেলায়)। যাচাইয়ের QR, ডিলার-পোর্টাল, লগইন আর
              পাসওয়ার্ড ফেরানোর লিংক এখানে নেই — সেগুলো ব্রাউজারেই খোলে।
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="erp.adi.com.bd"/>
                <data android:pathPrefix="/accounts"/>
                <data android:pathPrefix="/approvals"/>
                <data android:pathPrefix="/credit-control"/>
                <data android:pathPrefix="/customers"/>
                <data android:pathPrefix="/dashboard"/>
                <data android:pathPrefix="/documents"/>
                <data android:pathPrefix="/finance"/>
                <data android:pathPrefix="/governance"/>
                <data android:pathPrefix="/hr"/>
                <data android:pathPrefix="/inventory"/>
                <data android:pathPrefix="/master-data"/>
                <data android:pathPrefix="/notices"/>
                <data android:pathPrefix="/notification"/>
                <data android:pathPrefix="/notifications"/>
                <data android:pathPrefix="/owner"/>
                <data android:pathPrefix="/papers"/>
                <data android:pathPrefix="/promotions"/>
                <data android:pathPrefix="/purchase"/>
                <data android:pathPrefix="/reports"/>
                <data android:pathPrefix="/restaurant"/>
                <data android:pathPrefix="/sales"/>
                <data android:pathPrefix="/suppliers"/>
            </intent-filter>
        </activity>
        <!--
          The two home-screen widgets.

          Registered here rather than discovered: a widget is a broadcast
