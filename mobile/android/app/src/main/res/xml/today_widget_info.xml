<?xml version="1.0" encoding="utf-8"?>
<!--
  Four cells by three. At two cells tall the content does not fit and Android
  simply cuts the bottom off: a widget that is too tall for its cell is not an
  error, it is just quietly shorter than it was drawn, and the line that goes
  first is the one saying how old the figures are.

  resizeMode is horizontal and vertical, so somebody who wants it taller can
  make it taller.

  updatePeriodMillis is 30 minutes because that is the floor Android accepts;
  anything smaller is silently rounded up. Faster than that is WorkManager
  (15 minutes) and the app's own refresh on leaving, both on the Dart side.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/today_widget"
    android:previewLayout="@layout/today_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/today_widget_description" />
