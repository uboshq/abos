<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget kit: মালিকের পূর্ণ পর্দা (4x6 by default). Drawn by widgets/DocWidget.kt (Glance) from doc_owner_board.
  updatePeriodMillis 0: the app redraws it whenever it has new figures, and on lock/unlock.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="390dp"
    android:targetCellWidth="4"
    android:targetCellHeight="6"
    android:minResizeWidth="110dp"
    android:minResizeHeight="200dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_kit_description" />
