<?xml version="1.0" encoding="utf-8"?>
<!--
  The widgets' own ground: the app's primary green (AppColors.primary,
  0F6B4C), so the launcher tile and the app behind it read as one product.

  A shape, not a colour on the root view, because RemoteViews has no way to
  round a corner: the radius has to be baked into a drawable. 22dp matches
  what current launchers draw for their own widgets.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0F6B4C" />
    <corners android:radius="22dp" />
</shape>
