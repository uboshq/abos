<?xml version="1.0" encoding="utf-8"?>
<!--
  What is waiting for a signature, on the home screen. Two cells by two.

  RemoteViews cannot loop, so the rows are drawn out here and hidden one by
  one when there is nothing to put in them. Three, because that is what fits
  two cells of height under the count, and the count is the part somebody
  reads from across a room.

  Every row is a single line that ends in an ellipsis. Two cells is narrow,
  and a line that wrapped would push the one below it out of the widget, where
  it is cut off without a trace.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/approvals_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/approvals_title"
            android:textColor="#BFE3D3"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/approvals_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Shown only when the queue is empty, and then instead of the rows.
         "কিছু নেই" is news; three blank lines are not. -->
    <TextView
        android:id="@+id/approvals_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/approvals_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
    <TextView
        android:id="@+id/approvals_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
    <TextView
        android:id="@+id/approvals_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/approvals_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#C8F7DC"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Takes whatever height is left, so the as-of line sits on the bottom
         edge whether there are three rows above it or none. A TextView and
         not a View: RemoteViews refuses to inflate android.view.View and
         takes the whole widget down with it. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- When this was taken. A queue that cannot say how old it is will be
         believed on a morning it is a day stale. -->
    <TextView
        android:id="@+id/approvals_asof"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8FC7B0"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
