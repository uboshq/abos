            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/widget_col_month"
            android:textColor="#8FC7B0"
            android:textSize="9sp"
            android:maxLines="1" />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="0.9"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/widget_col_change"
            android:textColor="#8FC7B0"
            android:textSize="9sp"
