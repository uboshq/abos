# Flutter/Dart build output and tool state. Everything here is regenerated by
# `flutter pub get` / `flutter build`, and the lock file is deliberately NOT
# ignored -- an app whose dependency versions drift between machines is an app
# that builds on one laptop and not the other.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml

# Signing. A keystore in the repository is a signing key everybody has, and a
# build signed with a new key is one no installed phone will accept as an
# upgrade -- there is no way back from that except uninstalling every handset
# by hand.
*.jks
*.keystore
key.properties

# Local overrides
.env
